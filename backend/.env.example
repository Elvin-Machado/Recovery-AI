# backend/.env.example
# Copy this file to backend/.env and replace placeholders with your actual keys

SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_supabase_service_role_key

# Razorpay Sandbox Test Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_custom_webhook_secret
